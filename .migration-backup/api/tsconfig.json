{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "typeRoots": [
      "../types",
      "./types",
      "../node_modules/@types",
      "./node_modules/@types"
    ]
  },
  "include": ["./**/*", "../types/**/*"],
  "exclude": ["node_modules"]
}
