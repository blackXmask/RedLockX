# PostgreSQL connection string
# Supabase example: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# Railway example: postgresql://postgres:[password]@[host].railway.app:5432/railway
DATABASE_URL=postgresql://user:password@localhost:5432/redlockx

# Random secret for session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: override HuggingFace Space URLs
# HYBRID_SPACE_URL=https://blackxmask-redlockx-hybrid-prompt-detector-space-v2.hf.space
# ML_SPACE_URL=https://blackxmask-redlockx-ml-deberta-v3-prompt-detector-space.hf.space
