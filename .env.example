# Example environment variables for local development and deployment

# Postgres connection (Supabase or other)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session secret for signing cookies/sessions
SESSION_SECRET=change-me-to-a-long-random-string

# API port for local dev
PORT=8080

# Frontend base path (use / for most setups)
BASE_PATH=/

# Frontend should call this URL for API requests when deployed
# e.g. https://your-api.fly.dev
VITE_API_BASE_URL=http://localhost:8080

# Optional: override the HuggingFace Space endpoints used by the server
HYBRID_SPACE_URL=
ML_SPACE_URL=
# PostgreSQL connection string
# Supabase example: postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# Railway example: postgresql://postgres:[password]@[host].railway.app:5432/railway
DATABASE_URL=postgresql://user:password@localhost:5432/redlockx

# Random secret for session signing (generate with: openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: override HuggingFace Space URLs
# HYBRID_SPACE_URL=https://blackxmask-redlockx-hybrid-prompt-detector-space-v2.hf.space
# ML_SPACE_URL=https://blackxmask-redlockx-ml-deberta-v3-prompt-detector-space.hf.space
